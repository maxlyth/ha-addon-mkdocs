#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: MkDocs
# Vault watcher (library-managed PollingObserver) handles initial build + ongoing
# rebuilds. nginx serves the static output. inotify does not propagate through
# the addon container's bind-mount boundaries, which is why a polling fallback
# is used here — same approach used by mkdocs/hugo/vite when native FS events
# are unavailable.
# ==============================================================================
echo "Starting MkDocs (vault-watcher + nginx)"

. /opt/venv/bin/activate

# Watcher does initial sync + build, then polls for vault changes.
PYTHONUNBUFFERED=1 python3 /usr/local/bin/vault-watcher.py 2>&1 | sed 's/^/[watcher] /' &

# Wait for the initial build artifact before nginx starts.
for i in $(seq 1 30); do
    [ -d /tmp/mkdocs_built ] && break
    sleep 1
done

# nginx serves the built static site.
rm -rf /data/www
mkdir -p /data
ln -s /tmp/mkdocs_built /data/www
chmod 777 /data/www
chmod 777 /tmp/mkdocs_built

nginx -g "daemon off; error_log /dev/stdout debug;"
